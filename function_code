function [yn, yorigin] = advance(xn, xorigin, k)
    yn = xn;
    yorigin = xorigin + k;

    n_x = (1:length(xn)) - xorigin;
    n_y = (1:length(yn)) - yorigin;

    clf();
    plot2d3(n_x, xn, style=2);
    plot2d3(n_y, yn, style=5);
    xgrid();
    legend(["x(n)", "y(n) = x(n+k)"]);
    xtitle("Advance Operation: y(n) = x(n + " + string(k) + ")", "n", "Amp");
endfunction

