function [yn, yorigin] = add(x1n, x1origin, x2n, x2origin)
    n1 = (1:length(x1n)) - x1origin;
    n2 = (1:length(x2n)) - x2origin;

    n_min = min([n1, n2]);
    n_max = max([n1, n2]);
    n = n_min:n_max;

    y1 = zeros(1, length(n));
    y2 = zeros(1, length(n));

    y1(find(n >= n1(1) & n <= n1($))) = x1n;
    y2(find(n >= n2(1) & n <= n2($))) = x2n;

    yn = y1 + y2;
    yorigin = find(n == 0);

    clf();
    plot2d3(n, y1, style=2);
    plot2d3(n, y2, style=3);
    plot2d3(n, yn, style=5);
    xgrid();
    legend(["x1(n)", "x2(n)", "y(n) = x1(n)+x2(n)"]);
    xtitle("Addition", "n", "Amp");
endfunction

