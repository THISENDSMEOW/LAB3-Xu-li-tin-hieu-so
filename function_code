function [yn, yorigin] = fold(xn, xorigin)
    yn = xn($:-1:1);
    yorigin = length(xn) - xorigin + 1;

    n_x = (1:length(xn)) - xorigin;
    n_y = (1:length(yn)) - yorigin;

    clf();
    plot2d3(n_x, xn, style=2);
    plot2d3(n_y, yn, style=5);
    xgrid();
    legend(["x(n)", "y(n) = x(-n)"]);
    xtitle("Folding Operation: y(n) = x(-n)", "n", "Amp");
endfunction

